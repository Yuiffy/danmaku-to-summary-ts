{
  "schemaVersion": 1,
  "defaultEnvironment": "development",
  "baseFile": "default.json",
  "productionFile": "production.json",
  "productionEnvironments": ["production", "automation"],
  "secretFile": "secret.json",
  "secretMappings": [
    { "sources": ["gemini.apiKey"], "target": "ai.text.gemini.apiKey" },
    { "sources": ["tuZi.apiKey"], "target": "ai.comic.tuZi.apiKey" },
    { "sources": ["tuZi.textApiKey", "tuZi.apiKey"], "target": "ai.text.tuZi.apiKey" },
    { "sources": ["bilibili"], "target": "bilibili" },
    { "sources": ["wechatWork"], "target": "wechatWork" },
    { "sources": ["tuZiBalance"], "target": "ai.tuZiBalance" },
    { "sources": ["providers"], "target": "ai.providers" },
    { "sources": ["ai.providers"], "target": "ai.providers" }
  ],
  "daiYuTextAlias": {
    "provider": "ai.providers.daiYu",
    "target": "ai.text.daiYu",
    "defaultBaseUrl": "http://localhost:8080"
  },
  "environmentMappings": {
    "APP_ENVIRONMENT": "app.environment",
    "APP_LOG_LEVEL": "app.logLevel",
    "WEBHOOK_PORT": "webhook.port",
    "WEBHOOK_HOST": "webhook.host",
    "GEMINI_API_KEY": "ai.text.gemini.apiKey",
    "OPENAI_API_KEY": "ai.text.openai.apiKey",
    "STORAGE_BASE_PATH": "storage.basePath",
    "STORAGE_TEMP_PATH": "storage.tempPath",
    "STORAGE_OUTPUT_PATH": "storage.outputPath"
  }
}
