{
  "name": "danmaku-to-summary-ts",
  "version": "0.2.0",
  "private": true,
  "description": "自动处理直播录播文件，生成AI总结的工具",
  "main": "dist/app/main.js",
  "types": "dist/app/main.d.ts",
  "scripts": {
    "dev": "node dist/app/main.js --port 12522 --host 0.0.0.0",
    "build": "tsc --project tsconfig.build.json",
    "dev:next": "next dev",
    "build:next": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "jest",
    "build:ts": "tsc --project tsconfig.build.json",
    "build:all": "npm run build",
    "dev:ts": "tsc --project tsconfig.build.json --watch",
    "clean": "rimraf dist coverage",
    "build:isolated": "tsc --project tsconfig.build.json --outDir build/service --incremental false",
    "build:workflows": "node -r ts-node/register/transpile-only src/tools/workflows/buildWorkflowRelease.ts",
    "workflow:activate": "npm run build:workflows -- --activate",
    "type-check": "tsc --noEmit --incremental false",
    "build:check": "tsc --project tsconfig.build.json --noEmit",
    "architecture:check": "node -r ts-node/register/transpile-only src/tools/architecture/checkArchitecture.ts",
    "verify:core": "npm run build:workflows && npm run type-check && npm run build:check && npm run architecture:check && npm test -- --runInBand",
    "test:unit": "jest --runInBand --testPathIgnorePatterns tests/integration",
    "test:integration": "jest tests/integration",
    "test:e2e": "npm run test:integration",
    "test:all": "npm run verify:all",
    "test:node": "node --test tests/*.test.js",
    "test:compiled": "npm run build:isolated && jest --config tests/jest.compiled.config.cjs --runInBand",
    "test:python": "python -m unittest discover -b -s tests -p \"test_*.py\"",
    "test:python:asr": "python -m unittest discover -b -s src/scripts/python -p \"test_*.py\"",
    "verify:all": "npm run verify:core && npm run test:node && npm run test:python && npm run test:compiled",
    "webhook": "node dist/app/main.js",
    "webhook:dev": "node dist/app/main.js --port 12522 --host 0.0.0.0",
    "webhook:prod": "node dist/app/main.js --port 12522 --host 0.0.0.0  --env production",
    "process": "node dist/app/main.js process",
    "batch": "node dist/app/main.js batch",
    "tuzi:balance": "node src/scripts/tuzi_balance_check.js",
    "poststream:usage": "python src/scripts/post_stream_usage.py",
    "generation:modes": "node src/scripts/generation_modes.js",
    "seedance:queue": "node scripts/seedance_queue_runner.js",
    "seedance:queue:loop": "node scripts/seedance_queue_runner.js --loop",
    "seedance:queue:vip-fill": "node scripts/seedance_queue_runner.js --fill --max-vip-inflight 24 --max-normal-inflight 1 --max-submissions-per-pass 24 --submit-delay 2",
    "upload:clips": "python src/scripts/clip_upload_registry.py",
    "upload:clips:list": "python src/scripts/clip_upload_registry.py list",
    "upload:clips:queue": "python src/scripts/clip_upload_registry.py queue",
    "upload:clips:worker": "node scripts/clip_upload_queue_runner.js",
    "upload:clips:worker:loop": "node scripts/clip_upload_queue_runner.js --loop",
    "bilibili:clip-audit": "python src/scripts/audit_bilibili_clip.py",
    "manual:clips": "node src/scripts/manual_clip_queue.js",
    "clips:eval": "node -r ts-node/register/transpile-only src/tools/clipping/evaluate.ts",
    "topic:compile": "node src/scripts/clipping/topic_compilation.js",
    "clips:review": "node src/scripts/own_stream_review.js",
    "asr:hotword-benchmark": "node src/scripts/asr/hotword_benchmark.js",
    "asr:hotword-benchmark:vllm": "node src/scripts/asr/hotword_benchmark.js --backend fun_asr_nano_vllm",
    "asr:vllm-experiment": "node src/scripts/asr/asr_vllm_experiment.js",
    "asr:vllm-worker": "node src/scripts/asr/asr_vllm_queue_worker.js",
    "asr:vllm-doctor": "node src/scripts/asr/asr_vllm_doctor.js",
    "asr:speaker-once": "node src/scripts/asr/speaker_once_cli.js",
    "status": "node dist/app/main.js status",
    "help": "node dist/app/main.js help",
    "pm2:start": "pm2 start ecosystem.config.js --env production",
    "pm2:start:dev": "pm2 start ecosystem.config.js --env development",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:restart": "pm2 restart ecosystem.config.js",
    "pm2:reload": "pm2 reload ecosystem.config.js",
    "pm2:delete": "pm2 delete ecosystem.config.js",
    "pm2:logs": "pm2 logs danmaku-webhook",
    "pm2:logs:seedance": "pm2 logs seedance-queue-runner",
    "pm2:logs:clip-upload": "pm2 logs clip-upload-queue-runner",
    "pm2:status": "pm2 status danmaku-webhook",
    "pm2:status:seedance": "pm2 status seedance-queue-runner",
    "pm2:status:clip-upload": "pm2 status clip-upload-queue-runner",
    "pm2:list": "pm2 list",
    "pm2:save": "pm2 save",
    "pm2:startup": "pm2 startup",
    "pm2:monitor": "pm2 monit",
    "pm2:flush": "pm2 flush",
    "pm2:kill": "pm2 kill",
    "gpu:tdr:start": "pm2 start ecosystem.config.js --only gpu-tdr-capture --env production",
    "gpu:tdr:restart": "pm2 restart gpu-tdr-capture",
    "gpu:tdr:stop": "pm2 stop gpu-tdr-capture",
    "gpu:tdr:status": "pm2 status gpu-tdr-capture",
    "gpu:tdr:logs": "pm2 logs gpu-tdr-capture",
    "recorder:watchdog": "node scripts/recorder_watchdog.js",
    "recorder:status": "node scripts/recorder_watchdog.js status",
    "recorder:pause": "node scripts/recorder_watchdog.js pause",
    "recorder:resume": "node scripts/recorder_watchdog.js resume",
    "recorder:test": "node --test tests/recorder_watchdog.test.js",
    "pm2:recorder:start": "pm2 start ecosystem.config.js --only recorder-watchdog --env production",
    "pm2:recorder:stop": "pm2 stop recorder-watchdog",
    "pm2:recorder:logs": "pm2 logs recorder-watchdog",
    "restart:webhook": "npm run pm2:restart",
    "pm2:seedance:start": "pm2 start ecosystem.config.js --only seedance-queue-runner --env production",
    "pm2:seedance:restart": "pm2 restart seedance-queue-runner",
    "pm2:seedance:stop": "pm2 stop seedance-queue-runner",
    "pm2:clip-upload:start": "pm2 start ecosystem.config.js --only clip-upload-queue-runner --env production",
    "pm2:clip-upload:restart": "pm2 restart clip-upload-queue-runner",
    "pm2:clip-upload:stop": "pm2 stop clip-upload-queue-runner"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@node-rs/jieba": "^2.0.1",
    "@types/multer": "^2.0.0",
    "chalk": "^4.1.2",
    "commander": "^12.0.0",
    "dotenv": "^16.3.1",
    "express": "^5.2.1",
    "form-data": "^4.0.5",
    "fs-extra": "^11.2.0",
    "https-proxy-agent": "^7.0.6",
    "inversify": "^6.0.2",
    "joi": "^17.12.0",
    "moment": "^2.30.1",
    "multer": "^2.0.2",
    "next": "14.2.15",
    "node-fetch": "^2.7.0",
    "react": "^18",
    "react-dom": "^18",
    "reflect-metadata": "^0.2.2",
    "sharp": "^0.34.5",
    "winston": "^3.11.0",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/form-data": "^2.5.2",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^29.5.11",
    "@types/joi": "^17.2.3",
    "@types/node": "^20",
    "@types/node-fetch": "^2.6.13",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/supertest": "^6.0.2",
    "@types/xml2js": "^0.4.14",
    "eslint": "^8",
    "eslint-config-next": "14.2.15",
    "jest": "^30.2.0",
    "postcss": "^8",
    "rimraf": "^5.0.5",
    "supertest": "^6.3.4",
    "tailwindcss": "^3.4.1",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src",
      "<rootDir>/tests"
    ],
    "testMatch": [
      "**/__tests__/**/*.ts",
      "**/?(*.)+(spec|test).ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.d.ts",
      "!src/**/index.ts",
      "!src/**/types.ts"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.ts"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^@tests/(.*)$": "<rootDir>/tests/$1"
    }
  },
  "keywords": [
    "danmaku",
    "summary",
    "ai",
    "automation",
    "webhook",
    "livestream"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": ""
  },
  "bugs": {
    "url": ""
  },
  "homepage": ""
}
